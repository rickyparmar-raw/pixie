# Staging environment template — COPIES, never committed with values.
# Staging may reuse the workspace Slack credentials ONLY together with
# PIXIE_STAGING_ONLY_CHANNELS (staging guardrail: all other channels dropped).
# Never point a staging Core at the production database file.

# Central Slack credentials (same app tokens are acceptable ONLY with the
# staging channel allowlist below; a dedicated staging app is preferable).
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-

# Staging MUST list ONLY sandbox channels. Production traffic is dropped.
SLACK_HELP_CHANNEL=C0HELP00001
SLACK_FAQ_CHANNELS=C0HELP00001
PIXIE_STAGING_ONLY_CHANNELS=C0HELP00001

# Central model credentials (same pool is fine; staging volume is tiny).
HCAI_API_KEY=
OPENCODE_API_KEY=

# Fresh random token for the staging control-plane API (generate ONLY for staging).
PIXIE_INTERNAL_TOKEN=

# Disposable SQLite file for staging (do NOT reuse production pixie.db).
PIXIE_DB_PATH=/data/pixie-staging.db

# Workspace team id (confirm via Slack auth.test; used for tenant boundaries).
PIXIE_WORKSPACE_ID=

# Helpers allowed to teach/approve in staging.
PIXIE_ADMIN_USER_IDS=

# Optional: staging control plane + database.
# PIXIE_CORE_BASE_URL=http://staging-core:4100
# DATABASE_URL=postgres://user:pass@staging-db:5432/pixie
