# Supabase project holding the hosted_program* tables. Can be the same Pixl
# project the game server uses, or its own project — either way this holds
# live data, see lib/hostedPrograms.ts and lib/supabase.ts.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=service-role-key

# Hack Club Auth (https://auth.hackclub.com):
#  - Create an OAuth app at https://auth.hackclub.com/apps
#  - Redirect URI: <BASE_URL>/api/auth/callback
#  - Scopes: openid, email, profile, slack_id
HCA_CLIENT_ID=
HCA_CLIENT_SECRET=

# Comma-separated HCA identity ids/emails/domains allowed to sign in.
# Empty means anyone with a Hack Club Auth account.
PIXIE_WIZARD_ALLOWLIST=

# Comma-separated HCA identity ids/emails/domains allowed to CREATE a hosted
# program. Creation is invite-only: empty means nobody. Signing in, being
# added as a helper, and managing a program you already own are unaffected.
PIXIE_WIZARD_CREATOR_ALLOWLIST=

# Long random string for signing session cookies
SESSION_SECRET=

# Where this app runs (used for the Hack Club Auth redirect)
BASE_URL=http://localhost:4901

# Shared Pixie Core for hosted programs (Core lib/web/serve.js /internal/v1/*).
# Must be Core's PUBLIC HTTPS URL — this app runs on Vercel, which cannot
# reach a Railway *.railway.internal private-network address.
# The token below is server-side only — never expose it to the browser. Same
# value must be set on Core as PIXIE_INTERNAL_TOKEN. When unset, hosted
# programs still activate and save to Supabase; Core sync is skipped and the
# program is marked core_sync_state=pending until the reconciliation cron
# (see below) or a later settings save picks it up.
# PIXIE_CORE_BASE_URL=https://your-core-deployment.up.railway.app
# PIXIE_INTERNAL_TOKEN=

# Slack workspace (team) id hosted channel claims scope to.
# PIXIE_WORKSPACE_ID=

# Guards /api/cron/reconcile-hosted-sync (vercel.json), which retries hosted
# programs stuck at core_sync_state pending/failed. Unset means the route is
# reachable by anyone who finds the URL — set it before this app is public.
CRON_SECRET=
