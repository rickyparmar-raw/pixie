# Slack app (Socket Mode — no public URL/tunnel needed — see README)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_HELP_CHANNEL=C0XXXXXXX
SLACK_FAQ_CHANNELS=C0YYYYYYY

# OpenCode Zen (https://opencode.ai/zen) — OpenAI-compatible chat completions endpoint
OPENCODE_API_KEY=...
# OPENCODE_BASE_URL=https://opencode.ai/zen/v1/chat/completions
# PIXIE_MODEL=deepseek-v4-flash-free

# How often to re-fetch sources.json docs, in minutes (default 30)
# REFRESH_INTERVAL_MIN=30
