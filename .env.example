# Slack app (Socket Mode — no public URL/tunnel needed — see README)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_HELP_CHANNEL=C0XXXXXXX
# Comma-separated. The FIRST entry is the auto-reply channel (#pixl).
SLACK_FAQ_CHANNELS=C0YYYYYYY

# Who may teach pixie and approve what it learned. Comma-separated user IDs.
# Empty means nobody — the learning commands fail closed, since anything
# approved goes straight into the corpus every answer is grounded in.
PIXIE_ADMIN_USER_IDS=U0XXXXXXX

# OpenCode Zen (https://opencode.ai/zen) — OpenAI-compatible chat completions
OPENCODE_API_KEY=...
# Optional second Zen account. When set, pixie round-robins between the two —
# splits steady traffic across two free-tier quotas instead of exhausting one.
# OPENCODE_API_KEY_2=...

# Doc answers. Defaults to Zen; only set the base URL if you're self-hosting an
# OpenAI-compatible endpoint that actually serves PIXIE_MODEL.
# PIXIE_ANSWER_BASE_URL=https://opencode.ai/zen/v1
# PIXIE_MODEL=deepseek-v4-flash-free

# Intent classifier — the cheap "is this a question?" pass for #pixl.
# Falls back to OPENCODE_API_KEY when unset.
# INTENT_CLASSIFIER_API_KEY=...
# INTENT_CLASSIFIER_BASE_URL=https://opencode.ai/zen/v1
# INTENT_CLASSIFIER_MODEL=deepseek-v4-flash-free

# Image analysis. Falls back to OPENCODE_API_KEY / OPENCODE_BASE_URL.
# VISION_API_KEY=...
# PIXIE_VISION_BASE_URL=https://opencode.ai/zen/v1
# PIXIE_VISION_MODEL=mimo-v2.5-free

# --- Self-hosted gateway (9Router) --------------------------------------------
#
# 9Router is NOT opencode Zen. Zen is the hosted service above, reached with
# OPENCODE_API_KEY. 9Router is a separate OpenAI-compatible gateway you run
# yourself, with its own key and its own model names, and it serves models Zen
# doesn't — which is the only reason to point anything at it.
#
# Model names are that gateway's catalogue: "kr/claude-sonnet-4.5" resolves on a
# 9Router and nowhere else. Set the URL and the model together or the pair is
# nonsense.
#
# Prefer the PIXIE_*/INTENT_* URLs below over OPENCODE_BASE_URL. That one is
# read as the vision gateway URL despite its name, so pointing it at a 9Router
# reads as if opencode moved — which is exactly the confusion that cost a day.
#
# PIXIE_VISION_BASE_URL=http://9router.railway.internal:20128/v1
# PIXIE_VISION_MODEL=kr/claude-sonnet-4.5
# VISION_API_KEY=<9router key, not the Zen one>
#
# INTENT_CLASSIFIER_BASE_URL=http://9router.railway.internal:20128/v1
# INTENT_CLASSIFIER_MODEL=gc/gemini-3.1-flash-lite-preview
# INTENT_CLASSIFIER_API_KEY=<9router key, not the Zen one>
#
# Whenever a base URL is NOT Zen, pixie keeps Zen as a standby and retries there
# if the gateway is unreachable — so a dead 9Router costs you Sonnet, not the
# whole bot. Without it a thrown error becomes a null verdict, and HELP_ONLY
# reads null as "nobody was asking", which silenced pixie channel-wide. See
# lib/llm.js complete().
#
# On Railway the gateway must stay on the private network:
# deploy/9router/Dockerfile has the setup and the reason.

# How often to re-fetch sources.json docs, in minutes (default 30)
# REFRESH_INTERVAL_MIN=30

# Emoji pixie reacts with in the help channel when the docs can't answer —
# the marker helpers and Pixorpheus's ticket flow look for. Unset disables it.
# PIXIE_ESCALATE_REACTION=hii

# Where the weekly report gets posted (Mondays, 09:00). Defaults to
# SLACK_HELP_CHANNEL. With neither set the scheduled post is off and
# /pixie-report still works.
# PIXIE_REPORT_CHANNEL=C0123456789

# Per-message debug logging (off by default)
# PIXIE_DEBUG=1

# SQLite file. Defaults to ./pixie.db
# PIXIE_DB_PATH=./pixie.db

# Replaces the built-in "who are you / who made you" corpus section wholesale
# (same Q:/A: block shape as lib/identity.js's IDENTITY). Unset, pixie
# introduces itself as Pixl's bot — set this for any deployment that isn't
# actually Pixl.
# PIXIE_IDENTITY_OVERRIDE="Q: Who are you?\nA: I'm a bot for <program>..."

# Web console (Bun.serve, same process as the bot)
# Unset SLACK_CLIENT_ID to disable the web server entirely.
# PIXIE_WEB_PORT=4100
# PIXIE_WEB_URL=http://localhost:4100
# SLACK_CLIENT_ID=...
# SLACK_CLIENT_SECRET=...
# PIXIE_SESSION_SECRET=...   # long random string for cookie signing
