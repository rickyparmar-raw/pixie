{
  "display_information": {
    "name": "ishowseb",
    "description": "Answers questions from your docs, right in Slack.",
    "background_color": "#ec3750"
  },
  "features": {
    "bot_user": {
      "display_name": "ishowseb",
      "always_online": true
    },
    "slash_commands": [
      { "command": "/ishowseb", "description": "Private answer — help without cluttering the channel", "usage_hint": "[question]", "should_escape": false },
      { "command": "/ishowseb-guide", "description": "Interactive step-by-step walkthrough guides", "usage_hint": "[guide-name]", "should_escape": false },
      { "command": "/ishowseb-check", "description": "Check GitHub repository readiness for YSWS submission", "usage_hint": "<github_repo_url>", "should_escape": false },
      { "command": "/ishowseb-calc", "description": "Calculate build hours, RE progression, and shop item goals", "usage_hint": "<hours/re/item>", "should_escape": false },
      { "command": "/ishowseb-sources", "description": "What's loaded and when it last refreshed", "should_escape": false },
      { "command": "/ishowseb-stats", "description": "Answer rate, cache hits, feedback, latency", "should_escape": false },
      { "command": "/ishowseb-gaps", "description": "Top questions the docs didn't cover", "should_escape": false },
      { "command": "/ishowseb-report", "description": "The weekly report now", "usage_hint": "[last]", "should_escape": false },
      { "command": "/ishowseb-teach", "description": "Teach an answer directly", "usage_hint": "<question> :: <answer>", "should_escape": false },
      { "command": "/ishowseb-pending", "description": "Captured answers awaiting review", "should_escape": false },
      { "command": "/ishowseb-approve", "description": "Start using a captured answer", "usage_hint": "<n>", "should_escape": false },
      { "command": "/ishowseb-forget", "description": "Drop answer(s) by id, range, pending, or all", "usage_hint": "<target>", "should_escape": false },
      { "command": "/ishowseb-reload", "description": "Re-fetch the docs and clear the cache, no restart", "should_escape": false },
      { "command": "/ishowseb-program", "description": "Manage program channels and posture", "usage_hint": "[list|add|set|remove]", "should_escape": false }
    ],
    "shortcuts": [
      {
        "name": "Teach ishowseb from thread",
        "type": "message",
        "callback_id": "ishowseb_teach_thread",
        "description": "Capture this thread as a taught answer for review"
      }
    ],
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "channels:history",
        "groups:history",
        "channels:join",
        "app_mentions:read",
        "reactions:read",
        "reactions:write",
        "commands",
        "im:history",
        "im:write",
        "channels:read",
        "groups:read",
        "files:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "message.channels",
        "message.groups",
        "message.im",
        "app_mention",
        "reaction_added",
        "reaction_removed",
        "app_home_opened",
        "member_joined_channel"
      ]
    },
    "interactivity": { "is_enabled": true },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
